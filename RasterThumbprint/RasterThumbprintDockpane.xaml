<UserControl x:Class="RasterThumbprint.RasterThumbprintDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550"
             d:DesignWidth="350">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- TITLE -->

        <TextBlock Grid.Row="0"
                   Text="{Binding Heading}"
                   FontSize="20"
                   FontWeight="SemiBold"/>


        <!-- METHOD -->

        <TextBlock Grid.Row="2"
                   Text="Footprint method"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>

        <ComboBox Grid.Row="3"
                  ItemsSource="{Binding FootprintMethods}"
                  SelectedItem="{Binding SelectedMethod}"
                  Height="28"/>


        <!-- TOLERANCE -->

        <TextBlock Grid.Row="5"
                   Text="Simplification tolerance"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"/>

        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SimplificationTolerance,
                                    UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsToleranceEnabled}"
                     Height="26"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="map units"
                       VerticalAlignment="Center"/>

        </Grid>


        <!-- INPUT -->

        <Border Grid.Row="8"
                BorderThickness="1"
                Padding="10">

            <StackPanel>

                <TextBlock Text="Input"
                           FontWeight="SemiBold"/>

                <TextBlock
                    Text="Selected raster layers in the active map"
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </Border>


        <!-- OUTPUT INFORMATION -->

        <Border Grid.Row="10"
                BorderThickness="1"
                Padding="10">

            <StackPanel>

                <TextBlock Text="Output"
                           FontWeight="SemiBold"/>

                <TextBlock
                    Text="Create a File Geodatabase (.gdb) before running the tool. You will be asked to select it after clicking Create Thumbprints.  
After the thumbprints have been created, add the RasterThumbprints feature class from the geodatabase to the map manually."
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </Border>


        <!-- CREATE -->

        <Button Grid.Row="12"
                Content="CREATE THUMBPRINTS"
                Command="{Binding CreateThumbprintsCommand}"
                Height="38"
                FontWeight="SemiBold"/>


        <!-- STATUS -->

        <TextBlock Grid.Row="14"
                   Text="{Binding Status}"
                   Opacity="0.7"
                   TextWrapping="Wrap"/>

    </Grid>

</UserControl>